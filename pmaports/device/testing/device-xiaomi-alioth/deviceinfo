# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Xiaomi Poco F3"
deviceinfo_manufacturer="Xiaomi"
deviceinfo_codename="xiaomi-alioth"
deviceinfo_year="2021"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="handset"
deviceinfo_keyboard="false"
deviceinfo_external_storage="false"
deviceinfo_screen_width="1080"
deviceinfo_screen_height="2400"
deviceinfo_drm="true"

# The kernel config carries only the lzo backends for zram, and the default
# zstd makes zramctl fail outright with "failed to set algorithm".
deviceinfo_zram_swap_algo="lzo-rle"

# Kernel options
deviceinfo_dtb="qcom/sm8250-xiaomi-alioth"
deviceinfo_append_dtb="false"

# Bootloader related
# The stock ABL rejects mainline boot images, so the device is booted through
# Mu-Silicium UEFI flashed to the boot partition, which then loads systemd-boot.
deviceinfo_flash_method="none"

# Required for devices using UFS as storage (instead of e.g. eMMC)
deviceinfo_rootfs_image_sector_size="4096"
