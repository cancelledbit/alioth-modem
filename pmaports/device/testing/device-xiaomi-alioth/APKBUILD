# Reference: <https://postmarketos.org/devicepkg>
maintainer="cancelledbit <akadox@gmail.com>"
pkgname=device-xiaomi-alioth
pkgdesc="Xiaomi Poco F3"
pkgver=0.1
pkgrel=4
url="https://github.com/cancelledbit/alioth-modem"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	alioth-modem
	alsa-ucm-conf
	firmware-xiaomi-alioth-adsp
	firmware-xiaomi-alioth-cdsp
	firmware-xiaomi-alioth-gpu
	firmware-xiaomi-alioth-modem
	firmware-xiaomi-alioth-slpi
	firmware-xiaomi-alioth-venus
	linux-firmware-ath11k
	hexagonrpcd
	iio-sensor-proxy
	linux-firmware-cirrus
	linux-firmware-qca
	postmarketos-base
	soc-qcom
"
makedepends="devicepkg-dev"
source="
	alsa-ucm-conf/alioth.conf
	alsa-ucm-conf/HiFi.conf
	deviceinfo
	modules-initfs
"
subpackages="$pkgname-kernel-alioth:kernel_alioth"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	# Without a use case configuration the card is there but nothing routes to
	# it: PulseAudio finds no port and callaudiod skips the card entirely.
	install -Dm644 "$srcdir"/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/alioth.conf"
	install -Dm644 "$srcdir"/HiFi.conf \
		"$pkgdir/usr/share/alsa/ucm2/Xiaomi/alioth/HiFi.conf"

	# The file is looked up by the card's long name, not by its short one.
	mkdir -p "$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250"
	ln -s ../../Xiaomi/alioth/alioth.conf \
		"$pkgdir/usr/share/alsa/ucm2/conf.d/sm8250/Xiaomi-POCOF3-alioth-K11AG.conf"
}

kernel_alioth() {
	pkgdesc="Mainline 6.15 kernel with SDX55 modem support"
	depends="linux-postmarketos-alioth"
	devicepkg_subpackage_kernel $startdir $pkgname $subpkgname
}
