# Firmware blobs pulled from the stock Xiaomi Poco F3 (MIUI 14, alioth)
maintainer="cancelledbit <akadox@gmail.com>"
pkgname=firmware-xiaomi-alioth
pkgver=1
pkgrel=1
pkgdesc="Firmware for Xiaomi Poco F3 (alioth)"
url="https://github.com/cancelledbit/alioth-modem"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !tracedeps pmb:cross-native"
subpackages="
	$pkgname-adsp:adsp
	$pkgname-cdsp:cdsp
	$pkgname-gpu:gpu
	$pkgname-modem:modem
	$pkgname-slpi:slpi
	$pkgname-venus:venus
"
source="fw-alioth.tar.gz"
builddir="$srcdir/alioth"
_fwdir="usr/lib/firmware/qcom/sm8250/xiaomi/alioth"

package() {
	mkdir -p "$pkgdir"
}

adsp() {
	pkgdesc="Audio DSP firmware"
	install -Dm644 "$builddir"/adsp.mbn -t "$subpkgdir/$_fwdir/"
	install -Dm644 "$builddir"/adsp*.jsn -t "$subpkgdir/$_fwdir/"
}

cdsp() {
	pkgdesc="Compute DSP firmware"
	install -Dm644 "$builddir"/cdsp.mbn -t "$subpkgdir/$_fwdir/"
	install -Dm644 "$builddir"/cdspr.jsn -t "$subpkgdir/$_fwdir/"
}

gpu() {
	pkgdesc="Adreno 650 firmware"
	install -Dm644 "$builddir"/a650_zap.mbn -t "$subpkgdir/$_fwdir/"
	# The GPU refuses to come up without these two, and Plasma then falls back
	# to rendering on the CPU.  They would normally arrive with
	# linux-firmware-qcom, but that package fails to install from the mirror
	# here, and they are on the phone anyway.
	install -Dm644 "$builddir"/a650_sqe.fw "$builddir"/a650_gmu.bin \
		-t "$subpkgdir/usr/lib/firmware/qcom/"
}

modem() {
	pkgdesc="SDX55 modem firmware and its tqftpserv payload"
	install -Dm644 "$builddir"/modemr.jsn -t "$subpkgdir/$_fwdir/"
	cd "$builddir"
	find modem_pr -type f | while read -r f; do
		install -Dm644 "$f" "$subpkgdir/$_fwdir/$f"
	done
}

slpi() {
	pkgdesc="Sensor DSP firmware (SLPI is disabled in the device tree)"
	install -Dm644 "$builddir"/slpi.mbn -t "$subpkgdir/$_fwdir/"
}

venus() {
	pkgdesc="Venus video accelerator firmware"
	install -Dm644 "$builddir"/venus.mbn -t "$subpkgdir/$_fwdir/"
}
