# Userspace for the SDX55 modem in the Xiaomi Poco F3
maintainer="cancelledbit <akadox@gmail.com>"
pkgname=alioth-modem
pkgver=0.1
pkgrel=9
pkgdesc="Sahara, EFS and bring-up services for the SDX55 modem in the Poco F3"
url="https://github.com/cancelledbit/alioth-modem"
arch="aarch64"
license="MIT"
options="!check !archcheck"
depends="
	bash
	bluez
	qmi-utils
	modemmanager
	networkmanager
	pd-mapper
	python3
	qrtr
	tqftpserv
"
source="
	modem-up.sh
	sim-provision.sh
	sim-watch.sh
	wlan-mac.sh
	bt-addr.sh
	alioth-modem-firmware.sh
	alioth-modem.service
	alioth-modem-firmware.service
	alioth-wlan-mac.service
	alioth-sim-watch.service
	alioth-bt-addr.service
	77-mm-sdx55-qrtr.rules
	89-alioth-modem.preset
	sahara_srv.py
	efs_srv.py
	data_up.py
	smssend.py
	smsrecv.py
	voicecall.py
	efsdiag.py
	diagprobe.py
	mdmwatch.py
	gpiowatch.py
"

package() {
	install -Dm755 "$srcdir"/modem-up.sh "$pkgdir"/usr/bin/alioth-modem-up
	install -Dm755 "$srcdir"/sim-provision.sh "$pkgdir"/usr/bin/alioth-sim-provision
	install -Dm755 "$srcdir"/sim-watch.sh "$pkgdir"/usr/bin/alioth-sim-watch
	install -Dm755 "$srcdir"/wlan-mac.sh "$pkgdir"/usr/bin/alioth-wlan-mac
	install -Dm755 "$srcdir"/bt-addr.sh "$pkgdir"/usr/bin/alioth-bt-addr
	install -Dm755 "$srcdir"/alioth-modem-firmware.sh \
		"$pkgdir"/usr/bin/alioth-modem-firmware

	for f in sahara_srv efs_srv data_up smssend smsrecv voicecall efsdiag \
		diagprobe mdmwatch gpiowatch; do
		install -Dm755 "$srcdir/$f.py" -t "$pkgdir"/usr/share/alioth-modem/
	done

	for u in alioth-modem alioth-modem-firmware alioth-wlan-mac alioth-sim-watch alioth-bt-addr; do
		install -Dm644 "$srcdir/$u.service" -t \
			"$pkgdir"/usr/lib/systemd/system/
	done

	install -Dm644 "$srcdir"/77-mm-sdx55-qrtr.rules -t \
		"$pkgdir"/usr/lib/udev/rules.d/

	# The bring-up service loads the driver itself, in the right order: the
	# firmware servers have to be listening before the modem is powered up.
	mkdir -p "$pkgdir"/etc/modprobe.d
	echo "blacklist mhi_pci_generic" > \
		"$pkgdir"/etc/modprobe.d/mhi-manual.conf

	install -Dm644 "$srcdir"/89-alioth-modem.preset -t \
		"$pkgdir"/usr/lib/systemd/system-preset/

	install -dm755 "$pkgdir"/var/lib/alioth-modem
}
