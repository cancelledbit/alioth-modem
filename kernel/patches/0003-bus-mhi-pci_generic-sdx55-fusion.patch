+/*
+ * Probes for the flashless SDX55 (Poco F3): while the 84 MB qdsp6sw image is
+ * being fed over Sahara, the modem hits the SMMU with a fixed address that
+ * belongs to none of our buffers:
+ *
+ *   arm-smmu 15000000.iommu: Unhandled context fault: fsr=0x402,
+ *   iova=0x9403f000, fsynr=0x650011, cbfrsynra=0x1d01, cb=11
+ *
+ * Both probes are off by default and only apply to devices marked sbl_bounce.
+ */
+#define SDX_WIN_IOVA			0x94000000UL
+#define SDX_WIN_SIZE			SZ_2M
+#define SDX_WIN_POISON			0xa5a5dead
+
+static unsigned int sdx_dma_bits;
+module_param(sdx_dma_bits, uint, 0444);
+MODULE_PARM_DESC(sdx_dma_bits,
+		 "Override the DMA mask width (0 = per-device default). 30 keeps every IOVA below 0x40000000, where the stock mhi_0_iommu_group pool lives");
+
+static bool sdx_win;
+module_param(sdx_win, bool, 0444);
+MODULE_PARM_DESC(sdx_win,
+		 "Map a 2 MB scratch window at IOVA 0x94000000 so the modem's fixed-address writes land in a page of ours instead of faulting");
+
+static bool sdx_mm_cycle = true;
+module_param(sdx_mm_cycle, bool, 0644);
+MODULE_PARM_DESC(sdx_mm_cycle,
+		 "On entering mission mode, force one M3/D3hot suspend-resume cycle. Downstream does this so the device can switch to its mission mode PCIe PHY settings");
+
+static bool sdx_data = true;
+module_param(sdx_data, bool, 0444);
+MODULE_PARM_DESC(sdx_data,
+		 "Declare the IP_HW0 data channels and their hardware event rings. Turn off if the link starts dropping right after M0 again");
+
+static bool sdx_health = true;
+module_param(sdx_health, bool, 0644);
+MODULE_PARM_DESC(sdx_health,
+		 "Run the two-second health check that declares the device dead and starts recovery. Turn it off to watch what the modem does after it stops answering config reads");
+
+static bool sdx_rpm = true;
+module_param(sdx_rpm, bool, 0444);
+MODULE_PARM_DESC(sdx_rpm,
+		 "Allow runtime suspend of the modem (2 s autosuspend). Turn it off to rule the host's own power management out of a link loss");
+
+static int sdx_poll = -1;
