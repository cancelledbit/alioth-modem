+/*
+ * The platform's real MSI doorbell, from the stock qcom,pcie2_msi node:
+ * a register at 0x17a10040 whose 32 vectors are wired to GIC SPIs 0x340..0x35f.
+ * Downstream (pci-msm-msi.c) maps that register into each client's IOMMU domain
+ * and puts the resulting IOVA - plus the GIC hwirq as the message - into the
+ * client's MSI capability.  Mainline instead hands out a plain memory address
+ * that nothing on this controller listens to.  Claim one line and find out
+ * whether the downstream scheme rings through.
+ */
+#define SDX_BELL_PHYS			0x17a10040UL
+#define SDX_BELL_SPI			0x340
+
+static bool sdx_bell;
+module_param(sdx_bell, bool, 0444);
+MODULE_PARM_DESC(sdx_bell,
+		 "Point the modem's MSI capability at the platform doorbell at 0x17a10040 and claim GIC SPI 0x340, to test whether a real interrupt arrives");
+
+static bool sdx_msi = true;
+module_param(sdx_msi, bool, 0444);
+MODULE_PARM_DESC(sdx_msi,
+		 "Identity-map the MSI doorbell page into the device's IOMMU domain, so the modem's MSI writes survive the SMMU and reach the root complex");
