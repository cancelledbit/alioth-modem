+	{ }
+};
+MODULE_DEVICE_TABLE(of, sdx_modem_ctrl_match);
+
+static struct platform_driver sdx_modem_ctrl_driver = {
+	.probe = sdx_modem_ctrl_probe,
+	.remove = sdx_modem_ctrl_remove,
+	.driver = {
+		.name = "sdx-modem-ctrl",
+		.of_match_table = sdx_modem_ctrl_match,
+	},
+};
