+/*
+ * Bootloader log client.  Downstream pipes this into an IPC log; we have no
+ * such thing, so it goes to dmesg - which is exactly where we want it while
+ * the modem refuses to leave SBL.
+ */
+static void sdx_bl_dl_cb(struct mhi_device *mhi_dev, struct mhi_result *res)
+{
+	char *buf = res->buf_addr;
+	size_t len = res->bytes_xferd;
+	size_t pos = 0;
+
+	if (res->transaction_status || !buf || !len)
+		return;
+
+	/* the SBL sends plain text, not always terminated */
+	while (len && (buf[len - 1] == '\n' || buf[len - 1] == '\r' ||
+		       buf[len - 1] == '\0'))
+		len--;
+
+	if (!len) {
+		return;
+	}
+
+	/* one buffer carries several log lines, separated by NUL or newline */
+	while (pos < len) {
+		size_t run = pos;
+
+		while (run < len && buf[run] != '\0' && buf[run] != '\n' &&
+		       buf[run] != '\r')
+			run++;
+
+		pos = run + 1;
+	}
+}
