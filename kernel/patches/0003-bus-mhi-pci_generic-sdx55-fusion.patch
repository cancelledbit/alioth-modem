+static irqreturn_t sdx_bell_isr(int irq, void *data)
+{
+	struct mhi_pci_device *mhi_pdev = data;
+
+	mhi_pdev->bell_hits++;
+	pr_info_ratelimited("MHIDBG sdx_bell: rang, hit %u\n", mhi_pdev->bell_hits);
+
+	return IRQ_HANDLED;
+}
+
+static void sdx_bell_setup(struct mhi_pci_device *mhi_pdev, struct pci_dev *pdev)
+{
+	struct irq_fwspec fwspec = { };
+	struct device_node *np;
+	struct irq_data *idata;
+	dma_addr_t iova;
+	u32 hwirq;
+	u16 ctrl;
+	int virq, err;
+
+	if (!pdev->msi_enabled || !pdev->msi_cap) {
+		dev_warn(&pdev->dev, "MHIDBG sdx_bell: MSI not configured, skipping\n");
+		return;
+	}
+
+	np = of_find_compatible_node(NULL, NULL, "arm,gic-v3");
+	if (!np) {
+		dev_err(&pdev->dev, "MHIDBG sdx_bell: no GIC node\n");
+		return;
+	}
+	fwspec.fwnode = of_fwnode_handle(np);
+	fwspec.param_count = 3;
+	fwspec.param[0] = 0;			/* GIC_SPI */
+	fwspec.param[1] = SDX_BELL_SPI;
+	fwspec.param[2] = IRQ_TYPE_EDGE_RISING;
+	virq = irq_create_fwspec_mapping(&fwspec);
+	of_node_put(np);
+	if (virq <= 0) {
+		dev_err(&pdev->dev, "MHIDBG sdx_bell: cannot map SPI %#x\n", SDX_BELL_SPI);
+		return;
+	}
+
+	err = request_irq(virq, sdx_bell_isr, 0, "sdx_bell", mhi_pdev);
+	if (err) {
+		dev_err(&pdev->dev, "MHIDBG sdx_bell: request_irq(%d) failed: %d\n", virq, err);
+		irq_dispose_mapping(virq);
+		return;
+	}
+
+	iova = dma_map_resource(&pdev->dev, SDX_BELL_PHYS & PAGE_MASK, PAGE_SIZE,
+				DMA_FROM_DEVICE, 0);
+	if (dma_mapping_error(&pdev->dev, iova)) {
+		dev_err(&pdev->dev, "MHIDBG sdx_bell: cannot map the doorbell\n");
+		free_irq(virq, mhi_pdev);
+		irq_dispose_mapping(virq);
+		return;
+	}
+
+	idata = irq_get_irq_data(virq);
+	hwirq = idata ? (u32)irqd_to_hwirq(idata) : 0;
+
+	pci_read_config_word(pdev, pdev->msi_cap + PCI_MSI_FLAGS, &ctrl);
+	pci_write_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_LO,
+			       lower_32_bits(iova) + (SDX_BELL_PHYS & ~PAGE_MASK));
+	if (ctrl & PCI_MSI_FLAGS_64BIT) {
+		pci_write_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_HI,
+				       upper_32_bits(iova));
+		pci_write_config_word(pdev, pdev->msi_cap + PCI_MSI_DATA_64, hwirq);
+	} else {
+		pci_write_config_word(pdev, pdev->msi_cap + PCI_MSI_DATA_32, hwirq);
+	}
+
+	mhi_pdev->bell_dma = iova;
+	mhi_pdev->bell_virq = virq;
+
+	dev_info(&pdev->dev,
+		 "MHIDBG sdx_bell: doorbell %#lx -> iova %pad, SPI %#x = virq %d hwirq %u, capability rewritten\n",
+		 SDX_BELL_PHYS, &iova, SDX_BELL_SPI, virq, hwirq);
+}
+
+static void sdx_bell_teardown(struct mhi_pci_device *mhi_pdev, struct pci_dev *pdev)
+{
+	if (!mhi_pdev->bell_virq)
+		return;
+
+	dev_info(&pdev->dev, "MHIDBG sdx_bell: %u hits total\n", mhi_pdev->bell_hits);
+
+	free_irq(mhi_pdev->bell_virq, mhi_pdev);
+	irq_dispose_mapping(mhi_pdev->bell_virq);
+	dma_unmap_resource(&pdev->dev, mhi_pdev->bell_dma, PAGE_SIZE, DMA_FROM_DEVICE, 0);
+	mhi_pdev->bell_virq = 0;
+}
+
+/*
+ * The modem raises an MSI by writing the vector number to the address the host
+ * put in its MSI capability - reversing sbl1.mbn shows its SBL reading that
+ * capability and pointing an outbound ATU region at it.  That address comes
+ * from dw_pcie_msi_host_init(), which allocates it against the PCIe controller
+ * itself; the controller is no SMMU master, so what it hands out is a physical
+ * address.  The modem, which *is* behind the SMMU, then issues that address as
+ * an IOVA and the write faults.  The root complex only recognises its doorbell
+ * after translation, so map the page through to itself.
+ */
+static void sdx_msi_setup(struct mhi_pci_device *mhi_pdev, struct pci_dev *pdev)
+{
+	struct iommu_domain *domain;
+	u32 addr_lo = 0, addr_hi = 0;
+	unsigned long iova;
+	u16 ctrl;
+	int err;
+
+	if (pdev->msix_enabled) {
+		dev_warn(&pdev->dev,
+			 "MHIDBG sdx_msi: MSI-X in use, doorbell lives in the table, skipping\n");
+		return;
+	}
+	if (!pdev->msi_enabled || !pdev->msi_cap) {
+		dev_warn(&pdev->dev, "MHIDBG sdx_msi: MSI not configured, skipping\n");
+		return;
+	}
+
+	pci_read_config_word(pdev, pdev->msi_cap + PCI_MSI_FLAGS, &ctrl);
+	pci_read_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_LO, &addr_lo);
+	if (ctrl & PCI_MSI_FLAGS_64BIT)
+		pci_read_config_dword(pdev, pdev->msi_cap + PCI_MSI_ADDRESS_HI, &addr_hi);
+
+	if (addr_hi) {
+		dev_warn(&pdev->dev, "MHIDBG sdx_msi: doorbell above 4G (%#x_%08x), skipping\n",
+			 addr_hi, addr_lo);
+		return;
+	}
+	if (!addr_lo) {
+		dev_warn(&pdev->dev, "MHIDBG sdx_msi: doorbell address is zero, skipping\n");
+		return;
+	}
+
+	domain = iommu_get_domain_for_dev(&pdev->dev);
+	if (!domain) {
+		dev_err(&pdev->dev, "MHIDBG sdx_msi: no IOMMU domain, skipping\n");
+		return;
+	}
+
+	iova = addr_lo & PAGE_MASK;
+	err = iommu_map(domain, iova, iova, PAGE_SIZE,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_MMIO, GFP_KERNEL);
+	if (err) {
+		dev_err(&pdev->dev, "MHIDBG sdx_msi: iommu_map(%#lx) failed: %d\n", iova, err);
+		return;
+	}
+
+	mhi_pdev->msi_domain = domain;
+	mhi_pdev->msi_iova = iova;
+	dev_info(&pdev->dev,
+		 "MHIDBG sdx_msi: doorbell %#x identity-mapped (page %#lx), MSI should now land\n",
+		 addr_lo, iova);
+}
+
+static void sdx_msi_teardown(struct mhi_pci_device *mhi_pdev)
+{
+	if (!mhi_pdev->msi_domain)
+		return;
+
+	iommu_unmap(mhi_pdev->msi_domain, mhi_pdev->msi_iova, PAGE_SIZE);
+	mhi_pdev->msi_domain = NULL;
+}
+
+/*
+ * Fill the window with a position-dependent pattern, so a later dump tells
+ * apart what the modem wrote from what was never touched.
+ */
+static void sdx_win_fill(u32 *va)
+{
+	unsigned int i;
+
+	for (i = 0; i < SDX_WIN_SIZE / sizeof(*va); i++)
+		va[i] = SDX_WIN_POISON ^ (i * sizeof(*va));
+}
+
+/* Say which words of the window the modem wrote, and show the first of them. */
+static void sdx_win_report(struct mhi_pci_device *mhi_pdev, struct device *dev)
+{
+	const u32 *va = page_address(mhi_pdev->win_pages);
+	unsigned int n = SDX_WIN_SIZE / sizeof(*va);
+	unsigned int i, first = UINT_MAX, last = 0, changed = 0;
+
+	for (i = 0; i < n; i++) {
+		if (va[i] == (SDX_WIN_POISON ^ (i * sizeof(*va))))
+			continue;
+		if (first == UINT_MAX)
+			first = i;
+		last = i;
+		changed++;
+	}
+
+	if (!changed) {
+		dev_info(dev, "MHIDBG sdx_win: nothing written\n");
+		return;
+	}
+
+	dev_info(dev, "MHIDBG sdx_win: %u words written, iova %#lx..%#lx\n",
+		 changed, SDX_WIN_IOVA + first * sizeof(*va),
+		 SDX_WIN_IOVA + last * sizeof(*va) + sizeof(*va) - 1);
+	print_hex_dump(KERN_INFO, "MHIDBG sdx_win: ", DUMP_PREFIX_OFFSET, 16, 4,
+		       &va[first], min_t(unsigned int, 128, (n - first) * sizeof(*va)),
+		       false);
+}
