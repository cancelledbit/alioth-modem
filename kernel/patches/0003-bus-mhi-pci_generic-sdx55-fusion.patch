+static struct spmi_driver sdx_pon_driver = {
+	.probe = sdx_pon_probe,
+	.remove = sdx_pon_remove,
+	.driver = {
+		.name = "sdx-modem-pon",
+		.of_match_table = sdx_pon_match_table,
+	},
+};
+
+/*
+ * esoc handshake.  Downstream raises AP2MDM_STATUS 150 ms after the modem's
+ * warm reset and keeps it up; the modem reads it as "the apps processor is
+ * alive".  Held from probe here, which is what the six-run series validated.
+ */
+static void sdx_modem_log_lines(const char *when)
+{
+	if (!sdx_ctrl)
+		return;
+
+	dev_info(sdx_ctrl->dev,
+		 "MHIDBG esoc %s: ap2mdm_status=%d ap2mdm_errfatal=%d mdm2ap_status=%d mdm2ap_errfatal=%d\n",
+		 when,
+		 gpiod_get_value_cansleep(sdx_ctrl->ap2mdm_status),
+		 gpiod_get_value_cansleep(sdx_ctrl->ap2mdm_errfatal),
+		 gpiod_get_value_cansleep(sdx_ctrl->mdm2ap_status),
+		 gpiod_get_value_cansleep(sdx_ctrl->mdm2ap_errfatal));
+}
+
+static int sdx_modem_ctrl_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct sdx_modem_ctrl *ctrl;
+
+	ctrl = devm_kzalloc(dev, sizeof(*ctrl), GFP_KERNEL);
+	if (!ctrl)
+		return -ENOMEM;
+
+	ctrl->dev = dev;
+	ctrl->ap2mdm_status = devm_gpiod_get(dev, "ap2mdm-status", GPIOD_OUT_LOW);
+	if (IS_ERR(ctrl->ap2mdm_status))
+		return dev_err_probe(dev, PTR_ERR(ctrl->ap2mdm_status),
+				     "MHIDBG esoc: no ap2mdm-status line\n");
+
+	ctrl->ap2mdm_errfatal = devm_gpiod_get(dev, "ap2mdm-errfatal", GPIOD_OUT_LOW);
+	if (IS_ERR(ctrl->ap2mdm_errfatal))
+		return dev_err_probe(dev, PTR_ERR(ctrl->ap2mdm_errfatal),
+				     "MHIDBG esoc: no ap2mdm-errfatal line\n");
+
+	ctrl->mdm2ap_status = devm_gpiod_get(dev, "mdm2ap-status", GPIOD_IN);
+	if (IS_ERR(ctrl->mdm2ap_status))
+		return dev_err_probe(dev, PTR_ERR(ctrl->mdm2ap_status),
+				     "MHIDBG esoc: no mdm2ap-status line\n");
+
+	ctrl->mdm2ap_errfatal = devm_gpiod_get(dev, "mdm2ap-errfatal", GPIOD_IN);
+	if (IS_ERR(ctrl->mdm2ap_errfatal))
+		return dev_err_probe(dev, PTR_ERR(ctrl->mdm2ap_errfatal),
+				     "MHIDBG esoc: no mdm2ap-errfatal line\n");
+
+	sdx_ctrl = ctrl;
+	sdx_modem_log_lines("claimed");
+
+	/* apps processor is alive, and has nothing fatal to report */
+	gpiod_set_value_cansleep(ctrl->ap2mdm_errfatal, 0);
+	gpiod_set_value_cansleep(ctrl->ap2mdm_status, 1);
+	sdx_modem_log_lines("ap2mdm_status raised");
+
+	return 0;
+}
+
+static void sdx_modem_ctrl_remove(struct platform_device *pdev)
+{
+	if (sdx_ctrl)
+		gpiod_set_value_cansleep(sdx_ctrl->ap2mdm_status, 0);
+	sdx_ctrl = NULL;
+}
+
+static const struct of_device_id sdx_modem_ctrl_match[] = {
