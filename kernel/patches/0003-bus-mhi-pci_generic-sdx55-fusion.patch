+/*
+ * "Device died" on its own says nothing about who died.  Print what the host
+ * can still see: the config-space vendor word (all-ones means the link is not
+ * carrying transactions), the MHI status register out of BAR0, and the link
+ * speed and width the root complex reports.
+ */
+static void mhi_pci_report_death(struct mhi_controller *mhi_cntrl)
+{
+	struct pci_dev *pdev = to_pci_dev(mhi_cntrl->cntrl_dev);
+	u16 vendor = 0, lnksta = 0;
+	u32 mhistatus = ~0, mhictrl = ~0;
+	int err;
+
+	err = pci_read_config_word(pdev, PCI_VENDOR_ID, &vendor);
+	pcie_capability_read_word(pdev, PCI_EXP_LNKSTA, &lnksta);
+	/* raw offsets: host/reg.h is not visible from this module */
+	if (mhi_cntrl->regs) {
+		mhi_pci_read_reg(mhi_cntrl, mhi_cntrl->regs + 0x38, &mhictrl);
+		mhi_pci_read_reg(mhi_cntrl, mhi_cntrl->regs + 0x48, &mhistatus);
+	}
+
+	dev_err(&pdev->dev,
+		"Device died: vendor=%#06x (err %d) LNKSTA=%#06x MHICTRL=%#010x MHISTATUS=%#010x ee=%d pm_state=%#x\n",
+		vendor, err, lnksta, mhictrl, mhistatus,
+		mhi_cntrl->ee, mhi_cntrl->pm_state);
+}
