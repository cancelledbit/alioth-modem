+static void sdx_win_setup(struct mhi_pci_device *mhi_pdev, struct pci_dev *pdev)
+{
+	struct iommu_domain *domain;
+	phys_addr_t phys, readback;
+	int err;
+
+	domain = iommu_get_domain_for_dev(&pdev->dev);
+	if (!domain) {
+		dev_err(&pdev->dev, "MHIDBG sdx_win: no IOMMU domain, skipping\n");
+		return;
+	}
+
+	mhi_pdev->win_pages = alloc_pages(GFP_KERNEL, get_order(SDX_WIN_SIZE));
+	if (!mhi_pdev->win_pages) {
+		dev_err(&pdev->dev, "MHIDBG sdx_win: cannot allocate %u bytes\n",
+			(unsigned int)SDX_WIN_SIZE);
+		return;
+	}
+
+	phys = page_to_phys(mhi_pdev->win_pages);
+	sdx_win_fill(page_address(mhi_pdev->win_pages));
+
+	err = iommu_map(domain, SDX_WIN_IOVA, phys, SDX_WIN_SIZE,
+			IOMMU_READ | IOMMU_WRITE | IOMMU_CACHE, GFP_KERNEL);
+	if (err) {
+		dev_err(&pdev->dev, "MHIDBG sdx_win: iommu_map(%#lx) failed: %d\n",
+			SDX_WIN_IOVA, err);
+		__free_pages(mhi_pdev->win_pages, get_order(SDX_WIN_SIZE));
+		mhi_pdev->win_pages = NULL;
+		return;
+	}
+
+	readback = iommu_iova_to_phys(domain, SDX_WIN_IOVA);
+	if (readback != phys)
+		dev_warn(&pdev->dev,
+			 "MHIDBG sdx_win: readback %pa does not match %pa\n",
+			 &readback, &phys);
+
+	mhi_pdev->win_domain = domain;
+
+	mhi_pdev->win_blob.data = page_address(mhi_pdev->win_pages);
+	mhi_pdev->win_blob.size = SDX_WIN_SIZE;
+	mhi_pdev->win_dbg = debugfs_create_blob("mhi_sdx_win", 0400, NULL,
+					       &mhi_pdev->win_blob);
+
+	dev_info(&pdev->dev,
+		 "MHIDBG sdx_win: iova %#lx -> phys %pa, %u bytes, dump at /sys/kernel/debug/mhi_sdx_win\n",
+		 SDX_WIN_IOVA, &phys, (unsigned int)SDX_WIN_SIZE);
+}
+
+static void sdx_win_teardown(struct mhi_pci_device *mhi_pdev, struct device *dev)
+{
+	if (!mhi_pdev->win_pages)
+		return;
+
+	sdx_win_report(mhi_pdev, dev);
+
+	debugfs_remove(mhi_pdev->win_dbg);
+	mhi_pdev->win_dbg = NULL;
+
+	if (mhi_pdev->win_domain) {
+		iommu_unmap(mhi_pdev->win_domain, SDX_WIN_IOVA, SDX_WIN_SIZE);
+		mhi_pdev->win_domain = NULL;
+	}
+
+	__free_pages(mhi_pdev->win_pages, get_order(SDX_WIN_SIZE));
+	mhi_pdev->win_pages = NULL;
+}
