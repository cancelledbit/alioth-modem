+/*
+ * Answer the modem's bandwidth requests.  We do not retune the link yet: the
+ * point is that somebody answers at all, since an unanswered request is what
+ * makes the modem give up.  Downstream calls msm_pcie_set_link_bandwidth();
+ * the equivalent here is writing the target speed into the root port's LNKCTL2
+ * and retraining, which is the next step once this much is proven.
+ */
+static int sdx_bw_scale(struct mhi_controller *mhi_cntrl,
+			struct mhi_link_info *link_info)
+{
+	/*
+	 * Runs from the event ring tasklet, so nothing here may sleep - which
+	 * rules out PCI config access.  Downstream calls this from a worker
+	 * holding pm_mutex; retuning the link will have to be deferred the same
+	 * way.  For now the answer itself is the point.
+	 */
+	dev_info(mhi_cntrl->cntrl_dev,
+		 "MHIDBG bw: asked for speed %#x width %#x, accepting without retune\n",
+		 link_info->target_link_speed, link_info->target_link_width);
+
+	return 0;
+}
