+static int __init mhi_pci_init(void)
+{
+	int err;
+
+	err = mhi_driver_register(&sdx_tap_driver);
+	if (err)
+		return err;
+
+	err = mhi_driver_register(&sdx_bl_driver);
+	if (err)
+		return err;
+
+	/* the modem PMIC is optional: without it we just lose the warm reset */
+	err = spmi_driver_register(&sdx_pon_driver);
+	if (err)
+		pr_warn("MHIDBG sdx_reset: no modem PMIC driver: %d\n", err);
+
+	err = platform_driver_register(&sdx_modem_ctrl_driver);
+	if (err)
+		pr_warn("MHIDBG esoc: no modem control driver: %d\n", err);
+
+	err = pci_register_driver(&mhi_pci_driver);
+	if (err) {
+		spmi_driver_unregister(&sdx_pon_driver);
+		mhi_driver_unregister(&sdx_bl_driver);
+	}
+
+	return err;
+}
+module_init(mhi_pci_init);
+
+static void __exit mhi_pci_exit(void)
+{
+	pci_unregister_driver(&mhi_pci_driver);
+	platform_driver_unregister(&sdx_modem_ctrl_driver);
+	spmi_driver_unregister(&sdx_pon_driver);
+	mhi_driver_unregister(&sdx_bl_driver);
+	mhi_driver_unregister(&sdx_tap_driver);
+}
+module_exit(mhi_pci_exit);
 
