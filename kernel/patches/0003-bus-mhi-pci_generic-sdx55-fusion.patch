+	/* at least 10 sleep clock cycles between steps */
+	udelay(500);
+
+	err = sdx_pon_write(SDX_PON_SW_RST_S2_CTL, SDX_PON_WARM_RESET);
+	if (err)
+		return err;
+
+	err = sdx_pon_write(SDX_PON_SW_RST_S2_CTL2, SDX_PON_RESET_EN);
+	if (err)
+		return err;
+
+	udelay(500);
+
+	return sdx_pon_write(SDX_PON_SW_RST_GO, SDX_PON_GO);
+}
+
+static int sdx_reset_param_set(const char *val, const struct kernel_param *kp)
+{
+	int err;
+
+	sdx_modem_log_lines("before reset");
+	err = sdx_modem_warm_reset();
+	pr_info("MHIDBG sdx_reset: modem warm reset -> %d\n", err);
+	if (err)
+		return err;
+
+	/* esoc waits this long before telling the modem the AP is up */
+	msleep(150);
+	sdx_modem_log_lines("150 ms after reset");
+
+	return 0;
+}
+
+static int sdx_reset_param_get(char *buffer, const struct kernel_param *kp)
+{
+	if (!sdx_ctrl)
+		return sysfs_emit(buffer, "no modem control node\n");
+
+	return sysfs_emit(buffer,
+			  "ap2mdm_status=%d ap2mdm_errfatal=%d mdm2ap_status=%d mdm2ap_errfatal=%d\n",
+			  gpiod_get_value_cansleep(sdx_ctrl->ap2mdm_status),
+			  gpiod_get_value_cansleep(sdx_ctrl->ap2mdm_errfatal),
+			  gpiod_get_value_cansleep(sdx_ctrl->mdm2ap_status),
+			  gpiod_get_value_cansleep(sdx_ctrl->mdm2ap_errfatal));
+}
+
+static const struct kernel_param_ops sdx_reset_ops = {
+	.set = sdx_reset_param_set,
+	.get = sdx_reset_param_get,
+};
+module_param_cb(sdx_reset, &sdx_reset_ops, NULL, 0600);
+MODULE_PARM_DESC(sdx_reset,
+		 "Write anything here to warm-reset the modem through its PMIC, instead of rebooting the phone");
+
+static int sdx_pon_probe(struct spmi_device *sdev)
+{
+	sdx_pon_sdev = sdev;
+	dev_info(&sdev->dev, "MHIDBG sdx_reset: modem PMIC claimed, warm reset available\n");
+
+	return 0;
+}
+
+static void sdx_pon_remove(struct spmi_device *sdev)
+{
+	sdx_pon_sdev = NULL;
+}
