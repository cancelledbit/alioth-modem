diff --git a/drivers/net/wwan/mhi_wwan_ctrl.c b/drivers/net/wwan/mhi_wwan_ctrl.c
index e9f979d2d..6c71cbfe8 100644
--- a/drivers/net/wwan/mhi_wwan_ctrl.c
+++ b/drivers/net/wwan/mhi_wwan_ctrl.c
@@ -13,7 +13,7 @@ enum mhi_wwan_flags {
 	MHI_WWAN_RX_REFILL,
 };
 
-#define MHI_WWAN_MAX_MTU	0x8000
+#define MHI_WWAN_MAX_MTU	0x400
 
 struct mhi_wwan_dev {
 	/* Lower level is a mhi dev, upper level is a wwan port */
@@ -263,6 +263,22 @@ static const struct mhi_device_id mhi_wwan_ctrl_match_table[] = {
 	{ .chan = "QMI", .driver_data = WWAN_PORT_QMI },
 	{ .chan = "DIAG", .driver_data = WWAN_PORT_QCDM },
 	{ .chan = "FIREHOSE", .driver_data = WWAN_PORT_FIREHOSE },
+	/* SBL-only channel the SDX55 uses to pull its own images */
+	{ .chan = "SAHARA", .driver_data = WWAN_PORT_FIREHOSE },
+	/*
+	 * The flashless SDX55's remote file system.  It speaks Sahara here too,
+	 * but the other way round: on entering mission mode the modem sends a
+	 * HELLO and waits for the host to serve its NV out of mdm1m9kefs1..3.
+	 * XMMRPC is borrowed purely for the node name - it is unused on this
+	 * board, so the port cannot be confused with SAHARA's firehose.
+	 */
+	{ .chan = "EFS", .driver_data = WWAN_PORT_XMMRPC },
+	/*
+	 * The voice audio channel, as a plain port for now - enough to see
+	 * whether a call puts anything on it at all.  MBIM is borrowed for the
+	 * node name the same way XMMRPC is above: this board has no MBIM.
+	 */
+	{ .chan = "AUDIO_VOICE_0", .driver_data = WWAN_PORT_MBIM },
 	{},
 };
 MODULE_DEVICE_TABLE(mhi, mhi_wwan_ctrl_match_table);