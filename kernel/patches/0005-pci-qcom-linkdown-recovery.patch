diff --git a/drivers/pci/controller/dwc/pcie-qcom.c b/drivers/pci/controller/dwc/pcie-qcom.c
index dc98ae633..c0532ffd6 100644
--- a/drivers/pci/controller/dwc/pcie-qcom.c
+++ b/drivers/pci/controller/dwc/pcie-qcom.c
@@ -131,7 +131,24 @@
 /* PARF_LTSSM register fields */
 #define LTSSM_EN				BIT(8)
 
+/*
+ * Recovering the link automatically is off until it is proven safe: the first
+ * attempt deadlocked the machine.  mhi_ev_poll_work() polls the event rings
+ * from the system workqueue every 2 ms and mhi_sync_power_up() cannot finish
+ * without it, so recovery must never run there - it blocks on the device_lock
+ * that the in-flight probe holds, and the two wait for each other.  Recovery
+ * has its own ordered workqueue now, and by default only the manual debugfs
+ * trigger uses it, when nothing is bound to the endpoint.
+ */
+static bool qcom_pcie_auto_recover;
+module_param_named(auto_recover, qcom_pcie_auto_recover, bool, 0644);
+MODULE_PARM_DESC(auto_recover,
+		 "Recover the link automatically when it drops (default off)");
+
+static struct workqueue_struct *qcom_pcie_recover_wq;
+
 /* PARF_INT_ALL_{STATUS/CLEAR/MASK} register fields */
+#define PARF_INT_ALL_LINK_DOWN			BIT(1)
 #define PARF_INT_ALL_LINK_UP			BIT(13)
 #define PARF_INT_MSI_DEV_0_7			GENMASK(30, 23)
 
@@ -270,6 +287,11 @@ struct qcom_pcie {
 	union qcom_pcie_resources res;
 	struct phy *phy;
 	struct gpio_desc *reset;
+	struct work_struct recover_work;
+	struct dentry *recover_dbg;
+	bool recover_manual;
+	unsigned int link_down_count;
+	unsigned int recover_count;
 	struct icc_path *icc_mem;
 	struct icc_path *icc_cpu;
 	const struct qcom_pcie_cfg *cfg;
@@ -1554,6 +1576,110 @@ static void qcom_pcie_init_debugfs(struct qcom_pcie *pcie)
 				    qcom_pcie_link_transition_count);
 }
 
+static void qcom_pcie_log_link(struct qcom_pcie *pcie, const char *when)
+{
+	struct dw_pcie *pci = pcie->pci;
+	struct device *dev = pci->dev;
+	u16 lnksta = 0;
+	u16 offset;
+	u32 ltssm;
+
+	ltssm = readl_relaxed(pcie->parf + PARF_LTSSM);
+
+	/* the root bus has no bus->self, so go through DBI instead */
+	offset = dw_pcie_find_capability(pci, PCI_CAP_ID_EXP);
+	if (offset)
+		lnksta = dw_pcie_readw_dbi(pci, offset + PCI_EXP_LNKSTA);
+
+}
+
+/*
+ * Bring the link back after the endpoint has reset itself: drop what is left
+ * of the old device, cycle PERST, retrain, and re-enumerate.  Every step is
+ * logged so a failure says exactly how far it got.
+ */
+static void qcom_pcie_recover_work(struct work_struct *work)
+{
+	struct qcom_pcie *pcie = container_of(work, struct qcom_pcie, recover_work);
+	struct dw_pcie *pci = pcie->pci;
+	struct dw_pcie_rp *pp = &pci->pp;
+	struct device *dev = pci->dev;
+	struct pci_dev *pdev, *tmp;
+	int ret;
+
+	pcie->recover_count++;
+	qcom_pcie_log_link(pcie, "recover/before");
+
+	if (!pp->bridge || !pp->bridge->bus) {
+		return;
+	}
+
+	/*
+	 * Step 1, and the only one that keeps what the endpoint has booted:
+	 * just re-arm link training.  PERST resets the modem, which throws
+	 * away the AMSS image it has just finished loading - the whole point
+	 * of surviving the drop.
+	 */
+	qcom_pcie_start_link(pci);
+	ret = dw_pcie_wait_for_link(pci);
+	qcom_pcie_log_link(pcie, "recover/after-ltssm");
+
+	if (ret) {
+
+		pci_lock_rescan_remove();
+		list_for_each_entry_safe(pdev, tmp, &pp->bridge->bus->devices, bus_list) {
+			pci_stop_and_remove_bus_device(pdev);
+		}
+		pci_unlock_rescan_remove();
+
+		qcom_ep_reset_assert(pcie);
+		msleep(100);
+		qcom_ep_reset_deassert(pcie);
+		qcom_pcie_start_link(pci);
+
+		ret = dw_pcie_wait_for_link(pci);
+		qcom_pcie_log_link(pcie, "recover/after-perst");
+	}
+
+	if (ret && pcie->recover_manual) {
+		/*
+		 * Only from the manual trigger: pulling the PHY and clocks out
+		 * from under a bound driver that is mid-MMIO wedges the bus.
+		 */
+		qcom_pcie_host_deinit(pp);
+		ret = qcom_pcie_host_init(pp);
+		if (!ret) {
+			qcom_pcie_start_link(pci);
+			ret = dw_pcie_wait_for_link(pci);
+		}
+		qcom_pcie_log_link(pcie, "recover/after-hostinit");
+	} else if (ret) {
+	}
+
+	if (ret) {
+		return;
+	}
+
+	pci_lock_rescan_remove();
+	pci_rescan_bus(pp->bridge->bus);
+	pci_unlock_rescan_remove();
+
+	qcom_pcie_icc_opp_update(pcie);
+	qcom_pcie_log_link(pcie, "recover/done");
+}
+
+static int qcom_pcie_recover_set(void *data, u64 val)
+{
+	struct qcom_pcie *pcie = data;
+
+	pcie->recover_manual = true;
+	queue_work(qcom_pcie_recover_wq, &pcie->recover_work);
+
+	return 0;
+}
+DEFINE_DEBUGFS_ATTRIBUTE(qcom_pcie_recover_fops, NULL, qcom_pcie_recover_set,
+			 "%llu\n");
+
 static irqreturn_t qcom_pcie_global_irq_thread(int irq, void *data)
 {
 	struct qcom_pcie *pcie = data;
@@ -1563,19 +1689,26 @@ static irqreturn_t qcom_pcie_global_irq_thread(int irq, void *data)
 
 	writel_relaxed(status, pcie->parf + PARF_INT_ALL_CLEAR);
 
+
+	if (status & PARF_INT_ALL_LINK_DOWN) {
+		pcie->link_down_count++;
+		if (qcom_pcie_auto_recover) {
+			pcie->recover_manual = false;
+			queue_work(qcom_pcie_recover_wq, &pcie->recover_work);
+		} else {
+		}
+	}
+
 	if (FIELD_GET(PARF_INT_ALL_LINK_UP, status)) {
-		dev_dbg(dev, "Received Link up event. Starting enumeration!\n");
 		/* Rescan the bus to enumerate endpoint devices */
 		pci_lock_rescan_remove();
 		pci_rescan_bus(pp->bridge->bus);
 		pci_unlock_rescan_remove();
 
 		qcom_pcie_icc_opp_update(pcie);
-	} else {
-		dev_WARN_ONCE(dev, 1, "Received unknown event. INT_STATUS: 0x%08x\n",
-			      status);
 	}
 
+
 	return IRQ_HANDLED;
 }
 
@@ -1709,6 +1842,14 @@ static int qcom_pcie_probe(struct platform_device *pdev)
 	if (irq > 0)
 		pp->use_linkup_irq = true;
 
+	INIT_WORK(&pcie->recover_work, qcom_pcie_recover_work);
+
+	if (!qcom_pcie_recover_wq) {
+		qcom_pcie_recover_wq = alloc_ordered_workqueue("qcom-pcie-recover", 0);
+		if (!qcom_pcie_recover_wq)
+			return -ENOMEM;
+	}
+
 	ret = dw_pcie_host_init(pp);
 	if (ret) {
 		dev_err(dev, "cannot initialize host\n");
@@ -1732,8 +1873,16 @@ static int qcom_pcie_probe(struct platform_device *pdev)
 			goto err_host_deinit;
 		}
 
-		writel_relaxed(PARF_INT_ALL_LINK_UP | PARF_INT_MSI_DEV_0_7,
+		writel_relaxed(PARF_INT_ALL_LINK_DOWN | PARF_INT_ALL_LINK_UP |
+			       PARF_INT_MSI_DEV_0_7,
 			       pcie->parf + PARF_INT_ALL_MASK);
+
+
+		name = devm_kasprintf(dev, GFP_KERNEL, "qcom-pcie-recover-%d",
+				      pci_domain_nr(pp->bridge->bus));
+		if (name)
+			pcie->recover_dbg = debugfs_create_file(name, 0200, NULL,
+						pcie, &qcom_pcie_recover_fops);
 	}
 
 	qcom_pcie_icc_opp_update(pcie);
