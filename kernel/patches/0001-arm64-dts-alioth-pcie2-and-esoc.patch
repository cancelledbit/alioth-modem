+	/*
+	 * Прошивка поднимается и проходит проверку, но внутри неё стартует
+	 * пользовательский домен sensor_process, который ждёт закрытый демон
+	 * датчиков Qualcomm. На mainline его нет, поэтому сторожевой таймер
+	 * прошивки роняет SLPI каждые ~40 секунд. Сами датчики (акселерометр,
+	 * гироскоп, магнитометр, приближение) висят за SLPI и без этого демона
+	 * недоступны всё равно, так что включать его смысла нет.
+	 * Чтобы вернуть: status = "okay".
+	 */
+	status = "disabled";
 };
 
 &tlmm {
 	gpio-reserved-ranges = <28 4>, <40 4>;
 
+	ap2mdm_default: ap2mdm-default-state {
