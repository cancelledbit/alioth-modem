+/* SDX55 5G modem sits behind PCIe2; esoc handshake lines go to TLMM */
+&pcie2 {
+	pinctrl-0 = <&pcie2_default_state &mdm2ap_default &ap2mdm_default>;
+
+	status = "okay";
+};
+
+/*
+ * The SDX55 has its own PMIC (PMX55, "prairie") at SPMI SID 8.  The stock
+ * overlay describes it as qcom,pmxprairie@8 with a qcom,qpnp-power-on block at
+ * 0x800 marked qcom,modem-reset; esoc warm-resets the modem through it
+ * (sdx55m_toggle_soft_reset -> qpnp_pon_modem_pwr_off).  Only the PON block is
+ * described here, with a private compatible, so nothing else claims the device.
+ */
+&spmi_bus {
+	pmx55: pmic@8 {
+		compatible = "xiaomi,alioth-modem-pmic";
+		reg = <0x8 SPMI_USID>;
+	};
+};
+
+/*
+ * The esoc handshake lines, named in the stock qcom,mdm0 node.  Nothing in
+ * mainline drives them; the modem will not leave SBL until ap2mdm-status is
+ * high, which six runs with and without it showed cleanly.
+ */
+/ {
+	modem_ctrl: modem-ctrl {
+		compatible = "xiaomi,alioth-modem-ctrl";
+
+		ap2mdm-status-gpios = <&tlmm 56 GPIO_ACTIVE_HIGH>;
+		ap2mdm-errfatal-gpios = <&tlmm 57 GPIO_ACTIVE_HIGH>;
+		mdm2ap-status-gpios = <&tlmm 3 GPIO_ACTIVE_HIGH>;
+		mdm2ap-errfatal-gpios = <&tlmm 1 GPIO_ACTIVE_HIGH>;
+	};
+};
+
+&pcie2_phy {
+	vdda-phy-supply = <&vreg_l5a_0p88>;
+	vdda-pll-supply = <&vreg_l9a_1p2>;
+
+	status = "okay";
+};
+
 &pcieport0 {
 	wifi@0 {
 		compatible = "pci17cb,1101";
