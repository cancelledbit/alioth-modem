+/* Walk the capability list in the MHI register space, as downstream does */
+static int mhi_get_capability_offset(struct mhi_controller *mhi_cntrl,
+				     u32 capability, u32 *offset)
+{
+	u32 cur_cap, next_offset;
+	int ret;
+
+	ret = mhi_read_reg(mhi_cntrl, mhi_cntrl->regs, MHI_MISC_OFFSET, offset);
+	if (ret)
+		return ret;
+
+	do {
+		if (*offset >= mhi_cntrl->reg_len)
+			return -ENXIO;
+
+		ret = mhi_read_reg(mhi_cntrl, mhi_cntrl->regs, *offset, &cur_cap);
+		if (ret)
+			return ret;
+
+		next_offset = FIELD_GET(MHI_CAP_NEXT_CAP_MASK, cur_cap);
+		cur_cap = FIELD_GET(MHI_CAP_CAPID_MASK, cur_cap);
+
+		if (cur_cap == capability)
+			return 0;
+
+		*offset = next_offset;
+	} while (next_offset);
+
+	return -ENXIO;
+}
+
+static int mhi_get_er_index(struct mhi_controller *mhi_cntrl,
+			    enum mhi_er_data_type type)
+{
+	struct mhi_event *mhi_event = mhi_cntrl->mhi_event;
+	int i;
+
+	for (i = 0; i < mhi_cntrl->total_ev_rings; i++, mhi_event++)
+		if (mhi_event->data_type == type)
+			return mhi_event->er_index;
+
+	return -ENOENT;
+}
+
+/*
+ * The device asks the host to change the PCIe link bandwidth over a dedicated
+ * event ring, and waits for an answer.  Nothing answers unless the host says
+ * up front that it can, which is what this writes.
+ */
+static int mhi_init_bw_scale(struct mhi_controller *mhi_cntrl)
+{
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	u32 bw_cfg_offset, val;
+	int ret, er_index;
+
+	if (!mhi_cntrl->bw_scale) {
+		dev_dbg(dev, "No bandwidth scaling callback, skipping\n");
+		return -ENODEV;
+	}
+
+	ret = mhi_get_capability_offset(mhi_cntrl, MHI_BW_SCALE_CAP_ID,
+					&bw_cfg_offset);
+	if (ret) {
+		dev_info(dev, "Device does not offer bandwidth scaling\n");
+		return ret;
+	}
+
+	er_index = mhi_get_er_index(mhi_cntrl, MHI_ER_BW_SCALE);
+	if (er_index < 0) {
+		dev_warn(dev, "Device offers bandwidth scaling but no event ring is configured for it\n");
+		return er_index;
+	}
+
+	ret = mhi_get_channel_doorbell_offset(mhi_cntrl, &val);
+	if (ret)
+		return ret;
+
+	mhi_cntrl->bw_scale_db = mhi_cntrl->regs + val +
+				 (8 * MHI_BW_SCALE_CHAN_DB);
+
+	bw_cfg_offset += MHI_BW_SCALE_CFG_OFFSET;
+	mhi_write_reg(mhi_cntrl, mhi_cntrl->regs, bw_cfg_offset,
+		      MHI_BW_SCALE_SETUP(er_index));
+
+	dev_info(dev, "Bandwidth scaling on: cfg at %#x, event ring %d, doorbell +%#x\n",
+		 bw_cfg_offset, er_index, val + (8 * MHI_BW_SCALE_CHAN_DB));
+
+	return 0;
+}
