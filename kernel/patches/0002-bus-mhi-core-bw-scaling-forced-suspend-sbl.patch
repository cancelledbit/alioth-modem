+/*
+ * Some endpoints never raise an MSI for their event rings even though they do
+ * fill them in.  For those, walk the rings on a timer instead.
+ */
+void mhi_ev_poll_work(struct work_struct *work)
+{
+	struct mhi_controller *mhi_cntrl = container_of(to_delayed_work(work),
+						       struct mhi_controller,
+						       ev_poll_work);
+	int i;
+
+	if (!mhi_cntrl->mhi_ctxt ||
+	    MHI_PM_IN_ERROR_STATE(mhi_cntrl->pm_state))
+		return;
+
+	for (i = 0; i < mhi_cntrl->total_ev_rings; i++) {
+		struct mhi_event *mhi_event = &mhi_cntrl->mhi_event[i];
+
+		if (mhi_event->offload_ev)
+			continue;
+		mhi_irq_handler(0, mhi_event);
+	}
+
+	schedule_delayed_work(&mhi_cntrl->ev_poll_work, msecs_to_jiffies(2));
+}
