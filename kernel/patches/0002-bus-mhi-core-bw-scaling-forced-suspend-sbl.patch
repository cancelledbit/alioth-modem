+/*
+ * The device posts a bandwidth request here and waits for the host to write a
+ * result to the bandwidth doorbell.  Ported from the downstream
+ * mhi_process_bw_scale_ev_ring().
+ */
+void mhi_bw_scale_work(struct work_struct *work)
+{
+	struct mhi_controller *mhi_cntrl = container_of(work,
+						struct mhi_controller,
+						bw_scale_work);
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	struct mhi_link_info link_info = mhi_cntrl->bw_scale_req;
+	int result, ret;
+
+	ret = mhi_cntrl->bw_scale(mhi_cntrl, &link_info);
+	if (!ret)
+		mhi_cntrl->mhi_link_info = link_info;
+
+	result = ret ? MHI_BW_SCALE_NACK : 0;
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	if (likely(MHI_DB_ACCESS_VALID(mhi_cntrl)))
+		mhi_write_reg(mhi_cntrl, mhi_cntrl->bw_scale_db, 0,
+			      MHI_BW_SCALE_RESULT(result, link_info.sequence_num));
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	dev_info(dev, "Bandwidth request seq %d answered: %s (%d)\n",
+		 link_info.sequence_num, ret ? "NACK" : "ACK", ret);
+}
+
+int mhi_process_bw_scale_ev_ring(struct mhi_controller *mhi_cntrl,
+				 struct mhi_event *mhi_event, u32 event_quota)
+{
+	struct mhi_ring_element *dev_rp;
+	struct mhi_ring *ev_ring = &mhi_event->ring;
+	struct mhi_event_ctxt *er_ctxt =
+		&mhi_cntrl->mhi_ctxt->er_ctxt[mhi_event->er_index];
+	struct mhi_link_info link_info;
+	struct device *dev = &mhi_cntrl->mhi_dev->dev;
+	dma_addr_t ptr = le64_to_cpu(er_ctxt->rp);
+
+	/*
+	 * Called from mhi_ev_task() with mhi_event->lock already held, exactly
+	 * like the control and data ring handlers.  Taking it here again wedges
+	 * the tasklet for good - that cost a night once already.
+	 */
+	if (unlikely(MHI_EVENT_ACCESS_INVALID(mhi_cntrl->pm_state)))
+		return -EIO;
+
+	if (!mhi_cntrl->bw_scale || !mhi_cntrl->bw_scale_db) {
+		dev_err(dev, "Bandwidth event with no way to answer it\n");
+		return -EINVAL;
+	}
+
+	if (!is_valid_ring_ptr(ev_ring, ptr)) {
+		dev_err(dev, "Bandwidth event ring rp points outside of the ring\n");
+		return -EIO;
+	}
+
+	dev_rp = mhi_to_virtual(ev_ring, ptr);
+	if (ev_ring->rp == dev_rp)
+		return 0;
+
+	/* the newest element is the one before the device read pointer */
+	if (dev_rp == ev_ring->base)
+		dev_rp = ev_ring->base + ev_ring->len;
+	dev_rp--;
+
+	if (MHI_TRE_GET_EV_TYPE(dev_rp) != MHI_PKT_TYPE_BW_REQ_EVENT) {
+		dev_err(dev, "Unexpected event %u on the bandwidth ring\n",
+			(unsigned int)MHI_TRE_GET_EV_TYPE(dev_rp));
+		return -EIO;
+	}
+
+	link_info.target_link_speed = MHI_TRE_GET_EV_LINKSPEED(dev_rp);
+	link_info.target_link_width = MHI_TRE_GET_EV_LINKWIDTH(dev_rp);
+	link_info.sequence_num = MHI_TRE_GET_EV_BW_REQ_SEQ(dev_rp);
+
+	/* fast forward past everything we just consumed and hand the ring back */
+	ev_ring->rp = dev_rp;
+	ev_ring->wp = dev_rp - 1;
+	if (ev_ring->wp < ev_ring->base)
+		ev_ring->wp = ev_ring->base + ev_ring->len - ev_ring->el_size;
+	mhi_recycle_ev_ring_element(mhi_cntrl, ev_ring);
+
+	read_lock_bh(&mhi_cntrl->pm_lock);
+	if (likely(MHI_DB_ACCESS_VALID(mhi_cntrl)))
+		mhi_ring_er_db(mhi_event);
+	read_unlock_bh(&mhi_cntrl->pm_lock);
+
+	dev_info(dev, "Bandwidth request seq %d: speed %#x width %#x\n",
+		 link_info.sequence_num, link_info.target_link_speed,
+		 link_info.target_link_width);
+
+	/*
+	 * The answer needs a sleepable context: mhi_cntrl->bw_scale() may talk
+	 * to PCI config space.  system_unbound_wq is safe here only because
+	 * mhi_bw_scale_work() never blocks on device_lock - the recovery work
+	 * that does is what deadlocked against mhi_ev_poll_work() before.
+	 */
+	mhi_cntrl->bw_scale_req = link_info;
+	queue_work(system_unbound_wq, &mhi_cntrl->bw_scale_work);
+
+	return 0;
+}
