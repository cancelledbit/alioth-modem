[Unit]
Description=Bring up the SDX55 modem so ModemManager can use it
# Nothing here needs the network, but ModemManager must exist to be restarted
# at the end, and NetworkManager should already be running when it reappears.
After=systemd-modules-load.service NetworkManager.service alioth-modem-firmware.service
After=tqftpserv.service pd-mapper.service
Requires=alioth-modem-firmware.service
Wants=NetworkManager.service tqftpserv.service pd-mapper.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/alioth-modem-up
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target
